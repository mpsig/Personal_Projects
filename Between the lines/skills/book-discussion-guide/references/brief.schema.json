{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1"
    },
    "book": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "titleAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "authorAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publicationYear": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "pointOfView": {
          "type": "string",
          "minLength": 1
        },
        "premise": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "author",
        "titleAliases",
        "authorAliases",
        "publicationYear",
        "genre",
        "setting",
        "pointOfView",
        "premise"
      ],
      "additionalProperties": false
    },
    "summary": {
      "minItems": 3,
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "characters": {
      "minItems": 2,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "arc": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "role",
          "arc"
        ],
        "additionalProperties": false
      }
    },
    "themes": {
      "minItems": 3,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "interpretation"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1
          },
          "whyAsking": {
            "type": "string",
            "minLength": 1
          },
          "listenFor": {
            "type": "string",
            "minLength": 1
          },
          "followUp": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "question",
          "whyAsking",
          "listenFor",
          "followUp"
        ],
        "additionalProperties": false
      }
    },
    "parallels": {
      "minItems": 2,
      "maxItems": 4,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "documented",
              "hypothetical"
            ]
          },
          "connection": {
            "type": "string",
            "minLength": 1
          },
          "discussionPrompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "title",
          "kind",
          "connection",
          "discussionPrompt"
        ],
        "additionalProperties": false
      }
    },
    "authorFacts": {
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      }
    },
    "bigQuestion": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schemaVersion",
    "book",
    "summary",
    "characters",
    "themes",
    "questions",
    "parallels",
    "authorFacts",
    "bigQuestion",
    "limitations"
  ],
  "additionalProperties": false
}
