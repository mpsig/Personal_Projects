{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "input": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "author": {
          "default": "",
          "type": "string",
          "maxLength": 160
        },
        "grade": {
          "default": "",
          "type": "string",
          "maxLength": 40
        },
        "depth": {
          "default": "standard",
          "type": "string",
          "enum": [
            "standard",
            "advanced"
          ]
        }
      },
      "required": [
        "title",
        "author",
        "grade",
        "depth"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "responseIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "provenanceUrls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "guide": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": [
            "1.0",
            "1.1"
          ]
        },
        "book": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "author": {
              "type": "string",
              "minLength": 1
            },
            "titleAliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "authorAliases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "publicationYear": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "genre": {
              "type": "string",
              "minLength": 1
            },
            "setting": {
              "type": "string",
              "minLength": 1
            },
            "pointOfView": {
              "type": "string",
              "minLength": 1
            },
            "premise": {
              "type": "string",
              "minLength": 1
            },
            "claimIds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "title",
            "author",
            "titleAliases",
            "authorAliases",
            "publicationYear",
            "genre",
            "setting",
            "pointOfView",
            "premise",
            "claimIds"
          ],
          "additionalProperties": false
        },
        "summary": {
          "minItems": 3,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "text",
              "claimIds"
            ],
            "additionalProperties": false
          }
        },
        "characters": {
          "minItems": 2,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "arc": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name",
              "role",
              "arc",
              "claimIds"
            ],
            "additionalProperties": false
          }
        },
        "themes": {
          "minItems": 3,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "interpretation": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "name",
              "interpretation",
              "claimIds"
            ],
            "additionalProperties": false
          }
        },
        "questions": {
          "minItems": 5,
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1
              },
              "whyAsking": {
                "type": "string",
                "minLength": 1
              },
              "listenFor": {
                "type": "string",
                "minLength": 1
              },
              "followUp": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "question",
              "whyAsking",
              "listenFor",
              "followUp",
              "claimIds"
            ],
            "additionalProperties": false
          }
        },
        "parallels": {
          "minItems": 2,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "documented",
                  "hypothetical"
                ]
              },
              "connection": {
                "type": "string",
                "minLength": 1
              },
              "discussionPrompt": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "title",
              "kind",
              "connection",
              "discussionPrompt",
              "claimIds"
            ],
            "additionalProperties": false
          }
        },
        "authorFacts": {
          "minItems": 3,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "text",
              "claimIds"
            ],
            "additionalProperties": false
          }
        },
        "bigQuestion": {
          "type": "string",
          "minLength": 1
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "interpretation"
                ]
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "text",
              "kind",
              "sourceIds"
            ],
            "additionalProperties": false
          }
        },
        "quotes": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "claimIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "context": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "text",
              "sourceId",
              "claimIds",
              "context"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?:\\/\\/"
              },
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "author": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "publishedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accessedAt": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "author",
                  "publisher",
                  "educational",
                  "journalism",
                  "reference",
                  "corroboration"
                ]
              },
              "credibility": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "publisher",
              "author",
              "publishedAt",
              "accessedAt",
              "kind",
              "credibility"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "schemaVersion",
        "book",
        "summary",
        "characters",
        "themes",
        "questions",
        "parallels",
        "authorFacts",
        "bigQuestion",
        "claims",
        "quotes",
        "sources",
        "limitations"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "createdAt",
    "input",
    "model",
    "responseIds",
    "provenanceUrls",
    "guide"
  ],
  "additionalProperties": false
}
