OPENAI_API_KEY=
OPENAI_MODEL=
# Optional absolute directory on a persistent disk. Default: ./reports
REPORTS_DIR=
# Optional. Auto-detects the Codex executable bundled with the macOS app,
# then falls back to `codex` on PATH. Login is managed by Codex itself.
CODEX_BIN=
# Optional shared subscription override; blank uses economical stage defaults.
CODEX_MODEL=
# Separate economical API stages (override OPENAI_MODEL for both only if desired)
OPENAI_RESEARCH_MODEL=gpt-5-mini
OPENAI_WRITING_MODEL=gpt-5-nano
# Subscription defaults use Luna instead of inheriting a large Codex model.
CODEX_RESEARCH_MODEL=gpt-5.6-luna
CODEX_WRITING_MODEL=gpt-5.6-luna
